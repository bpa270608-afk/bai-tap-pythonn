numbers = list(map(int, input().split()))
for number in numbers:
    dem = 0

    if number < 2:
        print(0, end=" ")
    else:
        for i in range(2, number):
            if number % i == 0:
                dem += 1
        if dem == 0:
            print(0, end=" ")
        else:
            print(1, end=" ")
